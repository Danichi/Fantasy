{
  "name": "fantasy-game",
  "version": "0.3.0",
  "description": "Third-person Souls-like fantasy action RPG (three.js + Rapier)",
  "scripts": {
    "dev": "npm run assets:visual && vite",
    "build": "npm run assets:visual && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:visual": "node tools/install-visual-assets.mjs",
    "import:mixamo": "node tools/import-mixamo.mjs",
    "test": "playwright test",
    "desktop": "vite build && node electron/run.cjs",
    "dist": "vite build && electron-builder --win dir",
    "dist:installer": "vite build && electron-builder --win"
  },
  "type": "module",
  "devDependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fbx2gltf": "^0.9.7-p1",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "private": true,
  "main": "electron/main.cjs",
  "productName": "Fantasy RPG",
  "author": "Danichi",
  "build": {
    "appId": "com.danichi.fantasyrpg",
    "productName": "Fantasy RPG",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fantasy RPG",
      "artifactName": "Fantasy RPG Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Fantasy RPG Portable ${version}.${ext}"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
